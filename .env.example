# ─────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copia a `.env` y rellena con tus valores:
#     cp .env.example .env   &&   ./scripts/gen-config.sh
# Consigue las claves en: Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────────────────────────────────

# Públicas (van al frontend; protegidas por RLS)
SUPABASE_URL=https://TU_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...

# Secretas (solo administración; NUNCA en el frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
SUPABASE_DB_URL=postgresql://postgres.TU_REF:CONTRASEÑA@aws-1-REGION.pooler.supabase.com:6543/postgres
SUPABASE_JWKS_URL=https://TU_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
